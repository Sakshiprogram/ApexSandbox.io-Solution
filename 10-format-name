public String formatName(String firstName, String lastName) {
    //code here
    if(firstName.isNotBlank() &&  lastName.isNotBlank()){
        return firstName + ' ' + lastName;
    }else if(firstName.isNotBlank() && !lastName.isNotBlank()){
             return firstName;
    }else if(!firstName.isNotBlank() && lastName.isNotBlank()){
        return lastName;
    }else{
        return ' ';
    }
}