public static List<Integer> twoSum(List<Integer> nums, Integer target) {
     //code here
     Map<Integer, Integer> map = new Map<Integer, Integer>();

for (Integer i = 0; i < nums.size(); i++) {
    Integer currentNum = nums.get(i);
    Integer complement = target - currentNum;

    if (map.containsKey(complement)) {
        return new List<Integer>{map.get(complement), i};
    }
    map.put(currentNum, i);
}
return new List<Integer>();

}