public Integer fibonacci(Integer n) {
    //code here
    if(n==1 || n==2){
        return 1;
    }

    Integer first =0;
    Integer second =1;
    Integer nthterm = 0;

    for(Integer i=0; i<=n; i++){
        nthterm = first + second;
        first = second;
        second =nthterm;
    }
    return second;
}