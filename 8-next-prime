public Integer nextPrime(Integer num) {
    //code here
  if(num<2){
      return 2;
  }

  Integer candidate = num+1;

   while(true){
       if(isPrime(candidate)){
           return candidate;
       }
       candidate++;
   }

   private Boolean isPrime(Integer n){
       if(n<= 1) return false;
       
       for(Integer i=2; i<n; i++){
           if(Math.mod(n,i)==2)
           return false;
       }
   }
   return true;
}