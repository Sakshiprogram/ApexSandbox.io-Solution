public Integer nextPrime(Integer num) {
    if (num < 2) {
        return 2;
    }

    Integer candidate = num + 1;

    while (true) {
        // inline logic to check if candidate is prime
        Boolean isCandidatePrime = true;
        if (candidate <= 1) {
            isCandidatePrime = false;
        } else {
            for (Integer i = 2; i < candidate; i++) {
                if (Math.mod(candidate, i) == 0) {
                    isCandidatePrime = false;
                    break; // stop loop early, found a divisor
                }
            }
        }

        // if it passed the check, return it immediately
        if (isCandidatePrime) {
            return candidate;
        }
        candidate++;
    }
}
