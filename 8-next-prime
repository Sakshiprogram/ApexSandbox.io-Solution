public Integer nextPrime(Integer num) {
    //code here
    if (num < 2) {
    return 2;
}

Integer candidate = num + 1;
Integer foundPrime = 0;

while (foundPrime == 0) {
    Boolean isCandidatePrime = true;
    
    // Check if the candidate is prime
    for (Integer i = 2; i < candidate; i++) {
        if (Math.mod(candidate, i) == 0) {
            isCandidatePrime = false;
            break; 
        }
    }
    
    if (isCandidatePrime) {
        foundPrime = candidate;
    } else {
        candidate++;
    }
}

return foundPrime;

}