public Decimal average(List<Decimal> numbers){
    // your code here
    
  Integer n= numbers.size();
  Decimal sum =0;
  Decimal average =0;
  Decimal roundValue =0;
   
   for(Integer i=0; i<n; i++ ){
      sum += numbers.get(i);
      average = sum/n;
       roundValue = average.setScale(2);
   }
   return roundValue;
}